{:paths ["src"]
 ;; langgraph-clj brings langchain-clj transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace. This repo is standalone
 ;; (forkable outside the workspace); the :local/root paths only resolve
 ;; inside the monorepo checkout -- a standalone fork should override them
 ;; with git coordinates (see each dep's own `io.github.*` group id).
 :deps {io.github.com-junkawasaki/langgraph-clj
        {:local/root "../../kotoba-lang/langgraph"}
        ;; shared langchain.db store seam (EDN-blob codec + identity schema
        ;; + field-spec entity helpers), ADR-2607141600 -- CLAUDE.md
        ;; mandates this over hand-rolled enc/dec.
        io.github.kotoba-lang/langchain-store
        {:local/root "../../kotoba-lang/langchain-store"}
        ;; partners.cacao (JVM-only): canonical did:key + IPNS-name
        ;; derivation (ADR-2607050100) and SIWE/CBOR/Ed25519 CACAO mint --
        ;; the same libs `cloud-itonami.identity` uses for the flagship
        ;; actor's own self-mint identity.
        ;; The repository was renamed kotoba-lang/ed25519 -> kotoba-lang/org-ietf-ed25519.
        ;; The :local/root already points at the new name; only the coordinate
        ;; symbol still said the old one. Two symbols naming one repository are
        ;; two libraries to tools.deps, so ed25519.core was landing on the
        ;; classpath twice -- once from this checkout, once from the
        ;; org-ietf-ed25519 :git/sha another dependency in the closure pins.
        io.github.kotoba-lang/org-ietf-ed25519
        {:local/root "../../kotoba-lang/org-ietf-ed25519"}
        io.github.kotoba-lang/ipns
        {:local/root "../../kotoba-lang/tech-ipfs-specs-ipns"}
        io.github.kotoba-lang/org-chainagnostic-cacao
        {:local/root "../../kotoba-lang/org-chainagnostic-cacao"}}
 :aliases
 {;; This alias held an :override-deps entry for the retired coordinate
  ;; io.github.com-junkawasaki/langchain-clj. langgraph declares the same
  ;; library as io.github.kotoba-lang/langchain, so the entry matched no
  ;; node in the resolved tree and never reached the classpath -- verified
  ;; with `clojure -Stree`/-Spath, unchanged before and after removal.
  :dev {}
  ;; clojure -M:dev:run  -> drive one clean application + one HARD-hold
  ;; application through the actor
  :run {:main-opts ["-m" "partners.sim"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; PRIMARY gate: the same portable .cljc suite under a real
  ;; ClojureScript host (runtime priority: cljs first, JVM compat) --
  ;; excludes partners.cacao (JVM-only, guarded behind #?(:clj ...) in
  ;; partners.operation) and the cacao_test.clj JVM-only test.
  :cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                      thheller/shadow-cljs {:mvn/version "2.28.20"}}}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
